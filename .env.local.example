# .env.local.example
#
# Copiá este archivo como .env.local
# cp .env.local.example .env.local
#

# URL base de la app (Vercel la inyecta automáticamente)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------
# OPCIONAL — pero MUY recomendado para datos USA confiables
#
# FINNHUB_API_KEY: API key gratuita de Finnhub.io
#
# Cómo obtenerla (5 minutos):
#   1. Ir a https://finnhub.io
#   2. Click en "Get free API key" (arriba a la derecha)
#   3. Registrarse con email (sin tarjeta de crédito)
#   4. Copiar la API key que aparece en el dashboard
#   5. Pegarla aquí:
#
# FINNHUB_API_KEY=tu_api_key_aqui
#
# El plan gratuito incluye 60 requests/minuto — más que suficiente
# para este dashboard. Sin esta key, se usa Yahoo Finance con
# cookie+crumb dinámico (puede fallar ocasionalmente).
# ---------------------------------------------------------------

